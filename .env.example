# Names only. Put the real values in Render's Environment settings
# (or in a local .env file that is NEVER committed).

TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64 (url-safe). Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
# Public HTTPS address of this service, no trailing slash, e.g. https://klee-bot.onrender.com
PUBLIC_BASE_URL=
APP_ENV=production
LOG_LEVEL=INFO
# Optional: your numeric Telegram id(s), comma separated, allowed to run /updateicons (send /myid to the bot to see yours)
ADMIN_TELEGRAM_IDS=
